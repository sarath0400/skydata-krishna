# Fill these in once; every infra/*.sh script sources this file.
# ---------------------------------------------------------------------------

# GCP
export PROJECT_ID="krishna-504204"
export REGION="us-central1"          # always-free tier region
export ZONE="us-central1-a"

# GitHub — exact-replica default is ORG scope (matches Studio: org webhook,
# org runners, runner group "Default", GitHub App). Create a FREE GitHub org and
# put skydata-demo under it. (Set SCOPE=repo only if you deliberately want
# repo-level runners on a personal account.)
export SCOPE="repo"                   # org | repo   (personal account => repo)
export GITHUB_ORG="unused-in-repo-scope"             # used when SCOPE=org
export GITHUB_OWNER="sarath0400"                     # your GitHub username
export GITHUB_REPO="skydata-krishna"

# Derived — do not edit
if [ "$SCOPE" = "org" ]; then
  export GITHUB_URL="https://github.com/${GITHUB_ORG}"
  export GITHUB_API_SCOPE="orgs/${GITHUB_ORG}"
  export GITHUB_WEBHOOK_TARGET_LEVEL="orgs/${GITHUB_ORG}"
else
  export GITHUB_URL="https://github.com/${GITHUB_OWNER}/${GITHUB_REPO}"
  export GITHUB_API_SCOPE="repos/${GITHUB_OWNER}/${GITHUB_REPO}"
  export GITHUB_WEBHOOK_TARGET_LEVEL="repos/${GITHUB_OWNER}/${GITHUB_REPO}"
fi

# Fixed resource names (match SkyStudio)
export WEBHOOK_SERVICE="github-runner-webhook"
export SCHEDULER_JOB="github-runner-metrics"
export MIG_NAME="mig-github-runners"
export AUTOSCALER_NAME="autoscaler-github-runners"
export IMAGE_FAMILY="golden-runner"
export RUNNER_GROUP="Default"
